# Pinned dependency-policy tools for ci-supply-chain.yml, each with the URL the lane downloads and
# its SHA256. Generated by ci/supply-chain-pin.sh -- edit that, not this.
#
# Fetched and verified rather than run through the upstream actions: those curl the same binaries
# with no checksum, so pinning the action pins its Dockerfile and not what it executes.
#
# Renovate bumps the versions (custom manager in renovate.json). It cannot refresh the hashes or
# the URLs; renovate-pins.yml runs `ci/supply-chain-pin.sh` on its branch for that, and the
# checksum gate keeps the PR red until it has.
# renovate: datasource=github-releases depName=rustsec/rustsec
AUDIT_VERSION=0.23.0
AUDIT_URL=https://github.com/rustsec/rustsec/releases/download/cargo-audit%2Fv0.23.0/cargo-audit-x86_64-unknown-linux-musl-v0.23.0.tgz
AUDIT_SHA256=4f01c74ed84b2dffd0b1d37012a62cdf2a92c96e25bdf8eec7fcc0d4d3eb7811
# renovate: datasource=github-releases depName=EmbarkStudios/cargo-deny
DENY_VERSION=0.22.2
DENY_URL=https://github.com/EmbarkStudios/cargo-deny/releases/download/0.22.1/cargo-deny-0.22.1-x86_64-unknown-linux-musl.tar.gz
DENY_SHA256=13f7e825e9cb811c2f8de63f29b0f45851dfb53004029f0f2501af524728364d
