# Pinned FreeBSD release for the ci/freebsd-*.sh scripts, with the official
# hashes of the artifacts fetched at run time: the amd64 + arm64 VM images
# and the base.txz sets the link sysroots come from. Generated by
# ci/freebsd-pin.sh -- edit that, not this. Renovate bumps RELEASE when a new
# 14.x point release ships (custom manager in renovate.json; majors move by
# hand: the oldest supported major gives static binaries the widest reach).
# The URLs follow RELEASE, the hashes do not: a bump fetches the new release
# and stays red on the checksum gates until `ci/freebsd-pin.sh` runs on its
# branch.
# renovate: datasource=endoflife-date depName=freebsd
RELEASE=14.5
IMAGE_URL_AMD64=https://download.freebsd.org/releases/VM-IMAGES/${RELEASE}-RELEASE/amd64/Latest/FreeBSD-${RELEASE}-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2.xz
IMAGE_URL_ARM64=https://download.freebsd.org/releases/VM-IMAGES/${RELEASE}-RELEASE/aarch64/Latest/FreeBSD-${RELEASE}-RELEASE-arm64-aarch64-BASIC-CLOUDINIT-ufs.qcow2.xz
IMAGE_SHA512_AMD64=6778efae749f3a7ba2c6c953e15db9dcc633b51ce824bd8e6f2b0d9f447222555e75329fa89eec8b600aee62f5856335ac8a7a3273a2018a92c7715074b03b4b
IMAGE_SHA512_ARM64=27a7f049008bf245b6d88398ea76d21167eb1505df9e6e38c3bc37b3bc3e8ebcf32ed6502fca39cdc8017c5197e942a6dea8fbb94e29ed5438602935a605033a
BASE_URL_AMD64=https://download.freebsd.org/releases/amd64/${RELEASE}-RELEASE/base.txz
BASE_URL_ARM64=https://download.freebsd.org/releases/arm64/aarch64/${RELEASE}-RELEASE/base.txz
BASE_SHA256_AMD64=d16b68fe0e9e136ce67ab1084042c848bbffecd1eb295f206bd1c6785deb45a4
BASE_SHA256_ARM64=4b7a61ed4ddbd598b5048d5800898ba0d43dcba4cdb12ba58302e0202eaa26aa
